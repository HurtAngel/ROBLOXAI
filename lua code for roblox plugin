local function makeRuleCheckbox(key, labelTxt)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 23)
	b.BackgroundTransparency = 1
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 11
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.Parent = rulesPanel
	local function refresh()
		b.Text = (manualRules[key] and "☑ " or "☐ ") .. labelTxt
		b.TextColor3 = manualRules[key] and C.GREEN or C.MUTED
	end
	refresh()
	b.MouseButton1Click:Connect(function()
		manualRules[key] = not manualRules[key]
		refresh()
	end)
end

