local function updatePromptScrollSize()
	local txt = promptBox.Text or ""
	charCountLabel.Text = tostring(#txt) .. " karakter"
	local availW = math.max(200, promptScroll.AbsoluteSize.X - 28)
	local ok, bounds = pcall(function()
		return TextService:GetTextSize(txt, promptBox.TextSize, promptBox.Font, Vector2.new(availW, 100000))
	end)
	local targetH = math.max(180, (ok and bounds and bounds.Y or 0) + 36)
	promptBox.Size = UDim2.new(1, -10, 0, targetH)
	promptScroll.CanvasSize = UDim2.new(0, 0, 0, targetH)
end

promptBox:GetPropertyChangedSignal("Text"):Connect(updatePromptScrollSize)
