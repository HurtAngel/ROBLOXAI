resetSceneBtn.MouseButton1Click:Connect(function()
	resetSceneBtn.Text = "Temizleniyor..."
	ChangeHistoryService:SetWaypoint("AI Scene Reset Start")
	local removed = 0
	for _, ch in ipairs(workspace:GetChildren()) do
		if not ch:IsA("Camera") and not ch:IsA("Terrain") and ch.Name ~= "Baseplate" then
			local ok = pcall(function() ch:Destroy() end)
			if ok then removed += 1 end
		end
	end
	local containers = {
		ServerScriptService,
		StarterGui,
		ReplicatedStorage,
		ServerStorage,
		game:GetService("StarterPack"),
		StarterPlayer:FindFirstChild("StarterPlayerScripts"),
		StarterPlayer:FindFirstChild("StarterCharacterScripts"),
	}
	for _, c in ipairs(containers) do
		if c then
			for _, ch in ipairs(c:GetChildren()) do
				local ok = pcall(function() ch:Destroy() end)
				if ok then removed += 1 end
			end
		end
	end
	local lighting = game:GetService("Lighting")
	for _, ch in ipairs(lighting:GetChildren()) do
		if ch:IsA("PostEffect") or ch:IsA("Atmosphere") or ch:IsA("Sky") then
			pcall(function() ch:Destroy() end)
			removed += 1
		end
	end
	pcall(function() Players.CharacterAutoLoads = true end)
	if cleanKey() ~= "" then
		pcall(function()
			HttpService:RequestAsync({
				Url = DEFAULT_URL .. "/api/agent/memory",
				Method = "DELETE",
				Headers = getHeaders(false)
			})
		end)
	end
	resetDiscoveryState()
	lastSubmittedPrompt = ""
	capturedErrors = {}
	fixErrBtn.Text = "Output Hatalarını AI'ya Gönder ve Düzelt (0 Hata)"
	fixErrBtn.TextColor3 = C.MUTED
	ChangeHistoryService:SetWaypoint("AI Scene Reset End")
	task.wait(0.25)
	resetSceneBtn.Text = "🗑️ Sahneyi Sıfırla (Tek Tıkla Temizle)"
	logBox.Text = string.format("🗑️ Sahne sıfırlandı (%d nesne temizlendi, Baseplate korundu). Geri almak için Ctrl+Z.", removed)
end)

