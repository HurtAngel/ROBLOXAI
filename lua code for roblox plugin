local function buildDirectorCutscene(act)
	if act.disable_character == true then Players.CharacterAutoLoads = false
	elseif act.disable_character == false then Players.CharacterAutoLoads = true end

	local folder = ReplicatedStorage:FindFirstChild("AI_Cutscenes") or Instance.new("Folder", ReplicatedStorage)
	folder.Name = "AI_Cutscenes"
	local payloadJson = HttpService:JSONEncode({
		name = act.name or "MainCutscene", loop = act.loop == true,
		cinematic_bars = act.cinematic_bars == true, keyframes = act.keyframes or {}
	})
	local namedVal = folder:FindFirstChild(act.name or "MainCutscene") or Instance.new("StringValue", folder)
	namedVal.Name = act.name or "MainCutscene"
	namedVal.Value = payloadJson
	local activeVal = folder:FindFirstChild("ActiveCutscene") or Instance.new("StringValue", folder)
	activeVal.Name = "ActiveCutscene"
	activeVal.Value = payloadJson

	local sps = StarterPlayer:FindFirstChild("StarterPlayerScripts")
	if sps then
		local ls = sps:FindFirstChild("AI_DirectorCameraPlayer") or Instance.new("LocalScript", sps)
		ls.Name = "AI_DirectorCameraPlayer"
		ls.Source = getDirectorPlayerSource()
	end

	local kfs = act.keyframes or {}
	if #kfs > 0 and workspace.CurrentCamera then
		local first = kfs[1]
		local p, la = first.pos or {0, 15, 30}, first.look_at or {0, 0, 0}
		workspace.CurrentCamera.FieldOfView = tonumber(first.fov) or 70
		workspace.CurrentCamera.CFrame = CFrame.lookAt(Vector3.new(p[1] or 0, p[2] or 15, p[3] or 30), Vector3.new(la[1] or 0, la[2] or 0, la[3] or 0))
	end
	return namedVal.Name, #kfs
end

local function executeActions(actions)
	ChangeHistoryService:SetWaypoint("AI V4 Snapshot Start")
	local logs = {}
	for _, act in ipairs(actions) do
		local t = act.type
		pcall(function()
			if t == "create_instance" or t == "create_part" then
				local obj = Instance.new(act.class or "Part")
				obj.Name = act.name or (act.class or "Part")
				if obj:IsA("BasePart") then obj.Anchored = true end
				if obj:IsA("ScreenGui") then obj.Enabled = false end
				if act.properties then
					for k, v in pairs(act.properties) do pcall(function() obj[k] = convertProp(k, v) end) end
				end
				local targetParent = resolveOrSearchPath(act.parent)
				if obj:IsA("LocalScript") and (targetParent == StarterPlayer or act.parent == "StarterPlayer") then
					targetParent = StarterPlayer:FindFirstChild("StarterPlayerScripts") or targetParent
				end
				obj.Parent = targetParent or workspace
				table.insert(logs, "+ Oluşturuldu: " .. obj.Name)

			elseif t == "edit_instance" then
				local target = resolveOrSearchPath(act.path)
				if target and act.properties then
					for k, v in pairs(act.properties) do pcall(function() target[k] = convertProp(k, v) end) end
					table.insert(logs, "* Düzenlendi: " .. target.Name)
				end

			elseif t == "delete_instance" then
				local target = resolveOrSearchPath(act.path)
				if target then target:Destroy() table.insert(logs, "- Silindi: " .. act.path) end

			elseif t == "write_script" or t == "edit_script" then
				local sType = act.script_type or "Script"
				local target = resolveOrSearchPath(act.path)
				if t == "write_script" or not target then
					target = Instance.new(sType)
					target.Name = act.name or "AIScript"
					local targetParent = resolveOrSearchPath(act.parent)
					if sType == "LocalScript" and (targetParent == StarterPlayer or act.parent == "StarterPlayer" or not targetParent) then
						targetParent = StarterPlayer:FindFirstChild("StarterPlayerScripts") or ServerScriptService
					end
					target.Parent = targetParent or ServerScriptService
				end
				target.Source = act.source or ""
				table.insert(logs, "# Script Güncellendi: " .. target:GetFullName())

			elseif t == "create_animation" then
				local kfs, rig = buildKeyframeSequence(act)
				table.insert(logs, "🎬 Animasyon Üretildi: " .. kfs:GetFullName() .. (rig and (" (+ " .. rig.Name .. ".AnimSaves)") or ""))

			elseif t == "create_cutscene" then
				local cName, kfCount = buildDirectorCutscene(act)
				table.insert(logs, string.format("🎥 Yönetmen Kamerası Kuruldu: %s (%d Keyframe)", cName, kfCount))

			elseif t == "set_camera" then
				local cam = workspace.CurrentCamera
				if cam then
					local posArr, lookArr = act.position or {25, 18, 35}, act.look_at or {0, 0, 0}
					local lookVec = Vector3.new(lookArr[1] or 0, lookArr[2] or 0, lookArr[3] or 0)
					if act.target_path and act.target_path ~= "" then
						local tgt = resolveOrSearchPath(act.target_path)
						if tgt then lookVec = tgt:IsA("BasePart") and tgt.Position or (tgt:IsA("Model") and tgt:GetPivot().Position or lookVec) end
					end
					if act.fov then cam.FieldOfView = tonumber(act.fov) or 70 end
					cam.CFrame = CFrame.lookAt(Vector3.new(posArr[1] or 25, posArr[2] or 18, posArr[3] or 35), lookVec)
					table.insert(logs, "📷 Studio Kamerası Odaklandı")
				end

			elseif t == "create_plugin" then
				local folder = ServerStorage:FindFirstChild("GeneratedPlugins") or Instance.new("Folder", ServerStorage)
				folder.Name = "GeneratedPlugins"
				local ps = Instance.new("Script")
				ps.Name = act.name or "CustomPlugin"
				ps.Source = act.source or ""
				ps.Parent = folder
				table.insert(logs, "+ Plugin Üretildi: ServerStorage.GeneratedPlugins." .. ps.Name)

			elseif t == "insert_asset" then
				local objs = game:GetObjects("rbxassetid://" .. tostring(act.asset_id))
				if objs and #objs > 0 then
					local assetObj = objs[1]
					if act.name and act.name ~= "" then assetObj.Name = act.name end
					if act.strip_scripts == true then
						for _, d in ipairs(assetObj:GetDescendants()) do if d:IsA("LuaSourceContainer") then d:Destroy() end end
					end
					assetObj.Parent = resolveOrSearchPath(act.parent) or workspace
					if act.scale and type(act.scale) == "number" and act.scale > 0 and assetObj:IsA("Model") then pcall(function() assetObj:ScaleTo(act.scale) end) end
					local pos, rot = act.position or {0, 5, 0}, act.rotation or {0, 0, 0}
					local targetCF = CFrame.new(pos[1] or 0, pos[2] or 5, pos[3] or 0) * CFrame.Angles(math.rad(rot[1] or 0), math.rad(rot[2] or 0), math.rad(rot[3] or 0))
					if assetObj:IsA("Model") then pcall(function() assetObj:PivotTo(targetCF) end) elseif assetObj:IsA("BasePart") then assetObj.CFrame = targetCF end
					table.insert(logs, "📦 3D Model Eklendi: " .. assetObj.Name)
				end

			elseif t == "terrain_fill" then
				local mat = Enum.Material[act.material or "Grass"] or Enum.Material.Grass
				workspace.Terrain:FillBlock(CFrame.new(unpack(act.position or {0,0,0})), Vector3.new(unpack(act.size or {50,10,50})), mat)
				table.insert(logs, "+ Terrain Dolduruldu")

			elseif t == "run_luau" and act.code then
				local fn, err = loadstring(act.code)
				if fn then fn() table.insert(logs, "> Prosedürel Luau Çalıştırıldı")
				else table.insert(logs, "! Luau Hatası: " .. tostring(err)) end
			end
		end)
	end
	ChangeHistoryService:SetWaypoint("AI V4 Snapshot End")
	return table.concat(logs, "\n")
end

local function runAgentWorkflow(customPrompt, extraFiles, stepCount, syntaxRetries)
	stepCount = stepCount or 1
	syntaxRetries = syntaxRetries or 0
	if stepCount > 6 then
		logBox.Text = "Maksimum ajan adımına (6) ulaşıldı."
		runBtn.Text = "▶ Çalıştır"
		runBtn.BackgroundColor3 = C.ACCENT
		return
	end

	local body = HttpService:JSONEncode({
		prompt = customPrompt,
		thinking_mode = thinkingMode,
		is_syntax_repair = syntaxRetries > 0,
		directives = {
			auto_mode = autoMode,
			req_anim = manualRules.req_anim,
			req_cam = manualRules.req_cam,
			req_vfx = manualRules.req_vfx,
			req_weapon = manualRules.req_weapon
		},
		selected_items = gatherSelectedContext(),
		project_shortened_index = collectShortenedIndex(),
		scene_hierarchy = collectSceneHierarchy(),
		requested_files_content = extraFiles or {}
	})

	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = DEFAULT_URL .. "/api/agent/execute",
			Method = "POST",
			Headers = getHeaders(true),
			Body = body
		})
	end)

	if not ok or not res.Success then
		logBox.Text = "Hata: " .. tostring(res and res.Body or res)
		runBtn.Text = "▶ Çalıştır"
		runBtn.BackgroundColor3 = C.ACCENT
		return
	end

	local startData = HttpService:JSONDecode(res.Body)
	if startData.error then
		logBox.Text = "Hata: " .. startData.error
		runBtn.Text = "▶ Çalıştır"
		runBtn.BackgroundColor3 = C.ACCENT
		return
	end

	local taskId = startData.task_id
	local polling = true

	task.spawn(function()
		while polling do
			task.wait(0.8)
			local pOk, pRes = pcall(function()
				return HttpService:RequestAsync({
					Url = DEFAULT_URL .. "/api/agent/poll?task_id=" .. taskId,
					Method = "GET",
					Headers = getHeaders(false)
				})
			end)

			if pOk and pRes.Success then
				local pData = HttpService:JSONDecode(pRes.Body)
				logBox.Text = string.format("Adım %d | Durum: %s\n\n%s", stepCount, tostring(pData.status), tostring(pData.buffer or ""))

				if pData.status == "completed" then
					polling = false
					local result = pData.result or {}
					local needFiles = result.need_files or {}

					if #needFiles > 0 then
						local loadedFiles = extraFiles or {}
						local newlyLoaded = 0
						for _, fPath in ipairs(needFiles) do
							if not loadedFiles[fPath] then
								local targetObj = resolveOrSearchPath(fPath)
								if targetObj and targetObj:IsA("LuaSourceContainer") then
									loadedFiles[fPath] = string.sub(targetObj.Source, 1, 22000)
									newlyLoaded = newlyLoaded + 1
								else
									loadedFiles[fPath] = "-- [DOSYA BULUNAMADI]"
								end
							end
						end
						if newlyLoaded > 0 then
							logBox.Text = "Model ilgili dosyaları okuyor (" .. table.concat(needFiles, ", ") .. ")..."
							runAgentWorkflow(customPrompt, loadedFiles, stepCount + 1, syntaxRetries)
							return
						end
					end

					-- OTOMATİK SÖZDİZİMİ (SYNTAX) ÖN KONTROLÜ
					local syntaxErrs = validateActionsSyntax(result.actions or {})
					if #syntaxErrs > 0 and syntaxRetries < 2 then
						logBox.Text = "⚠️ Sözdizimi hatası yakalandı, sahne bozulmadan arka planda sessizce onarılıyor...\n" .. table.concat(syntaxErrs, "\n")
						local repairPrompt = customPrompt .. "\n\n[OTOMATİK SYNTAX ONARIMI]: Az önce ürettiğin Luau kodunda şu sözdizimi hataları tespit edildi, lütfen tüm hataları düzeltip temiz JSON döndür:\n" .. table.concat(syntaxErrs, "\n")
						runAgentWorkflow(repairPrompt, extraFiles, stepCount + 1, syntaxRetries + 1)
						return
					end

					local report = executeActions(result.actions or {})
					logBox.Text = "Plan: " .. tostring(result.thought or "") .. "\n\n" .. report .. "\n\nTamamlandı."
					verifyAccount()
					runBtn.Text = "▶ Çalıştır"
					runBtn.BackgroundColor3 = C.ACCENT

				elseif pData.status == "failed" then
					polling = false
					logBox.Text = "Hata: " .. tostring(pData.error)
					runBtn.Text = "▶ Çalıştır"
					runBtn.BackgroundColor3 = C.ACCENT
				end
			end
		end
	end)
end

-- İKİLİ KURTARMA (GERİ AL & YENİDEN DENE) + YENİ OTURUM
local function performRollback()
	pcall(function() ChangeHistoryService:Undo() end)
	if cleanKey() ~= "" then
		pcall(function()
			HttpService:RequestAsync({
				Url = DEFAULT_URL .. "/api/agent/rollback",
				Method = "POST",
				Headers = getHeaders(false)
			})
		end)
	end
end

undoBtn.MouseButton1Click:Connect(function()
	undoBtn.Text = "Geri Alınıyor..."
	performRollback()
	task.wait(0.3)
	undoBtn.Text = "↩️ Geri Al"
	logBox.Text = "↩️ Sahne bir önceki çalışan haline döndürüldü ve son hatalı adım AI hafızasından silindi."
end)

retryBtn.MouseButton1Click:Connect(function()
	if cleanKey() == "" or lastSubmittedPrompt == "" then
		logBox.Text = "Yeniden denenecek önceki bir komut yok."
