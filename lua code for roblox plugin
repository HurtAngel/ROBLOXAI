				loco[model] = nil
				continue
			end
			local hum = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if not hum or not root then continue end
			local pos = root.Position
			if st.lastPos and dt > 0 then
				local d = Vector3.new(pos.X - st.lastPos.X, 0, pos.Z - st.lastPos.Z).Magnitude / dt
				st.speed = st.speed + (math.min(d, 60) - st.speed) * math.min(1, dt * 10)
			end
			st.lastPos = pos
			local walkA, runA, idleA = model:GetAttribute("AI_WalkAnim"), model:GetAttribute("AI_RunAnim"), model:GetAttribute("AI_IdleAnim")
			local want, rate = nil, 1
			if hum.Health > 0 then
				if st.speed > 0.8 then
					if runA and st.speed > (model:GetAttribute("AI_RunThreshold") or 17) then
						want, rate = runA, st.speed / 24
					else
						want, rate = walkA, st.speed / 12
					end
				else
					want = idleA
				end
			end
			if want ~= st.current then
				if st.current then
					local old = getTrack(model, st.current)
					if old then old:Stop(0.2) end
				end
				st.current = want
				if want then
					local tr = getTrack(model, want)
					if tr then
						tr.Looped = true
						tr.Priority = (want == idleA) and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Movement
						tr:Play(0.2)
					end
				end
			end
			if want and want ~= idleA then
				local tr = getTrack(model, want)
				if tr then tr:AdjustSpeed(math.clamp(rate, 0.5, 2.2)) end
			end
		end
	end)

	-- Koşu (Shift)
	local sprinting = false
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.LeftShift and script:GetAttribute("SprintEnabled") then sprinting = true end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then sprinting = false end
	end)

	-- Kamera sistemi
	local function applyZoom()
		local mode = script:GetAttribute("CameraMode") or "default"
		local dist = tonumber(script:GetAttribute("CamDistance")) or 10
		if mode == "third_person" or mode == "follow" then
			player.CameraMode = Enum.CameraMode.Classic
			player.CameraMinZoomDistance = math.max(0.5, dist * 0.6)
			player.CameraMaxZoomDistance = dist * 1.4
		elseif mode == "first_person" then
			player.CameraMode = Enum.CameraMode.LockFirstPerson
		end
	end
	applyZoom()
	script:GetAttributeChangedSignal("CameraMode"):Connect(applyZoom)
	player.CharacterAdded:Connect(function() task.wait(0.1) applyZoom() end)

	local curFov, smoothPos = nil, nil
	RunService:BindToRenderStep("AIKitCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		if not cam then return end
		local mode = script:GetAttribute("CameraMode") or "default"
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local baseFov = tonumber(script:GetAttribute("CamFov")) or 70
		local sprintFov = tonumber(script:GetAttribute("CamSprintFov")) or (baseFov + 12)
		local dist = tonumber(script:GetAttribute("CamDistance")) or 10
		local height = tonumber(script:GetAttribute("CamHeight")) or 2
		local shoulder = tonumber(script:GetAttribute("CamShoulder")) or 0

		if hum and script:GetAttribute("SprintEnabled") then
			local walkSpeed = tonumber(script:GetAttribute("WalkSpeed")) or 16
			local sprintSpeed = tonumber(script:GetAttribute("SprintSpeed")) or 26
			hum.WalkSpeed = sprinting and sprintSpeed or walkSpeed
		end

		-- Evrensel harekete duyarlı dinamik FOV (yürüme + koşu + hızlanmada yumuşak açılır, durunca normale döner)
		local speed = 0
		if root then
			local v = root.AssemblyLinearVelocity
			speed = Vector3.new(v.X, 0, v.Z).Magnitude
		end
		local speedFactor = (speed > 0.6) and math.clamp(speed / 26, 0, 1.25) or 0
		local targetFov = baseFov + speedFactor * (sprintFov - baseFov)
		curFov = curFov or cam.FieldOfView
		curFov = curFov + (targetFov - curFov) * math.min(1, dt * 5.5)
		fovKick = fovKick + (0 - fovKick) * math.min(1, dt * 8)
		if mode ~= "cutscene" then
			cam.FieldOfView = math.clamp(curFov + fovKick, 20, 110)
		end

		if mode == "third_person" or mode == "follow" then
			if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
			if hum then
				local off = (mode == "third_person") and Vector3.new(shoulder, height * 0.25, 0) or Vector3.new(0, 0, 0)
				hum.CameraOffset = hum.CameraOffset:Lerp(off, math.min(1, dt * 8))
			end
			if mode == "third_person" and script:GetAttribute("CamLockMouse") and hum and root and hum.Health > 0 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				hum.AutoRotate = false
				local look = cam.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude > 0.01 then
					root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
				end
			elseif hum then
				hum.AutoRotate = true
			end
		elseif mode == "top_down" or mode == "isometric" or mode == "side_scroller" or mode == "broadcast" then
			local focus = root and root.Position or Vector3.new(0, 0, 0)
			local tPath = script:GetAttribute("CamTarget")
			if tPath and tPath ~= "" then
				local tObj = resolve(tPath)
				local tPos = nil
				if tObj and tObj:IsA("BasePart") then tPos = tObj.Position
				elseif tObj and tObj:IsA("Model") then tPos = tObj:GetPivot().Position end
				if tPos then focus = (mode == "broadcast" and root) and tPos:Lerp(root.Position, 0.3) or tPos end
			end
			local desired
			if mode == "top_down" then
				desired = focus + Vector3.new(0, dist, dist * 0.35)
			elseif mode == "isometric" then
				desired = focus + Vector3.new(dist * 0.7, dist * 0.8, dist * 0.7)
			elseif mode == "side_scroller" then
				desired = focus + Vector3.new(0, height, dist)
			else
				desired = Vector3.new(focus.X, focus.Y + height, focus.Z + dist)
			end
			smoothPos = smoothPos and smoothPos:Lerp(desired, math.min(1, dt * 5)) or desired
			cam.CameraType = Enum.CameraType.Scriptable
			local lookAt = (mode == "side_scroller") and Vector3.new(smoothPos.X, focus.Y + height * 0.3, focus.Z) or focus
			cam.CFrame = CFrame.lookAt(smoothPos, lookAt)
		end

		-- Sarsıntı (tüm modlarda en son uygulanır)
		local now = os.clock()
		if now < shakeUntil and shakeAmp > 0 then
			local amp = shakeAmp * math.clamp((shakeUntil - now) * 3, 0, 1)
			local c = now * 25
			cam.CFrame = cam.CFrame * CFrame.Angles(
				math.rad(math.noise(c, 0.3) * amp * 4),
				math.rad(math.noise(c, 1.7) * amp * 4),
				math.rad(math.noise(c, 3.1) * amp * 2)
			)
		else
			shakeAmp = 0
		end
	end)
end


return AIKit
