local function cleanKey()
	local cleaned = string.gsub(keyInput.Text or "", "%s+", "")
	keyInput.Text = cleaned
	return cleaned
end

local function getHeaders(hasBody)
	local h = { ["Client-Key"] = cleanKey() }
	if hasBody then h["Content-Type"] = "application/json" end
	return h
end

local function verifyAccount()
	local k = cleanKey()
	if k == "" then return end
	plugin:SetSetting("V3_ClientKey", k)
	accountBadge.Text = "  Doğrulanıyor..."
	accountBadge.TextColor3 = C.AMBER

	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = DEFAULT_URL .. "/api/auth/me",
			Method = "GET",
			Headers = getHeaders(false)
		})
	end)

	if not ok then
		accountBadge.Text = "  Bağlantı Hatası (HTTP Ayarını Kontrol Et)"
		accountBadge.TextColor3 = C.RED
		logBox.Text = "Sunucu Bağlantı Hatası:\n" .. tostring(res)
		return
	end

	if res.Success then
		local info = HttpService:JSONDecode(res.Body)
		if info.role == "admin" then
			accountBadge.Text = string.format("  Hesap: %s [ADMIN - Sınırsız]", info.username)
			accountBadge.TextColor3 = C.GREEN
		else
			accountBadge.Text = string.format("  Hesap: %s [%s Token]", info.username, tostring(info.tokens))
			accountBadge.TextColor3 = C.ACCENT
		end
	else
		accountBadge.Text = string.format("  Hata (HTTP %d): Geçersiz Key", res.StatusCode)
		accountBadge.TextColor3 = C.RED
		logBox.Text = string.format("Doğrulama Başarısız (HTTP %d):\n%s", res.StatusCode, tostring(res.Body))
	end
end

