local SEARCH_SERVICES = {
	ServerScriptService,
	StarterGui,
	StarterPlayer,
	ReplicatedStorage,
	ServerStorage,
	workspace
}

local function getAllProjectScripts()
	local list = {}
	for _, srv in ipairs(SEARCH_SERVICES) do
		for _, desc in ipairs(srv:GetDescendants()) do
			if desc:IsA("LuaSourceContainer") and desc.Name ~= "AI_LongPrompt" and not string.find(desc:GetFullName(), "GeneratedPlugins") then
				table.insert(list, desc)
			end
		end
	end
	return list
end

indexNowBtn.MouseButton1Click:Connect(function()
	if cleanKey() == "" then logBox.Text = "Önce Client API Key girin." return end
	local scripts = getAllProjectScripts()
	if #scripts == 0 then logBox.Text = "Projede indekslenecek script bulunamadı." return end

	indexNowBtn.Text = "Taranıyor..."
	logBox.Text = string.format("%d adet script özetleyici AI modeline gönderiliyor...", #scripts)

	local payloadScripts = {}
	for _, s in ipairs(scripts) do
		table.insert(payloadScripts, { path = s:GetFullName(), class = s.ClassName, source = string.sub(s.Source, 1, 8000) })
	end

	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = DEFAULT_URL .. "/api/agent/summarize",
			Method = "POST",
			Headers = getHeaders(true),
			Body = HttpService:JSONEncode({ scripts = payloadScripts })
		})
	end)

	indexNowBtn.Text = "İndeks Çıkar"
	if ok and res.Success then
		local data = HttpService:JSONDecode(res.Body)
		local summaries = data.summaries or {}
		local shortenedLines = {}
		local count = 0

		ChangeHistoryService:SetWaypoint("AI Index Update")
		for _, s in ipairs(scripts) do
			local p = s:GetFullName()
			local sum = summaries[p]
			if sum then
				count = count + 1
				local cleanSrc = string.gsub(s.Source, "\n%-%- %[AI_SUMMARY%]:.*", "")
				s.Source = cleanSrc .. "\n-- [AI_SUMMARY]: " .. tostring(sum)
				table.insert(shortenedLines, p .. " (" .. s.ClassName .. ") -> " .. tostring(sum))
			end
		end
		ChangeHistoryService:SetWaypoint("AI Index Update End")

		local idxVal = ServerStorage:FindFirstChild("AI_ShortenedIndex") or Instance.new("StringValue", ServerStorage)
		idxVal.Name = "AI_ShortenedIndex"
		idxVal.Value = table.concat(shortenedLines, "\n")

		logBox.Text = string.format("İndeks tamamlandı! %d script özetlendi ve AI_ShortenedIndex güncellendi.", count)
		verifyAccount()
	else
		logBox.Text = "İndeksleme hatası: " .. tostring(res and res.Body or res)
	end
end)

local function collectShortenedIndex()
	if not readIndexChecked then return {} end
	local indexList = {}
	for _, s in ipairs(getAllProjectScripts()) do
		local summary = string.match(s.Source, "%-%- %[AI_SUMMARY%]:%s*(.-)\n?$")
		table.insert(indexList, { Path = s:GetFullName(), Class = s.ClassName, Summary = summary or "Henüz özetlenmedi" })
	end
	return indexList
end

