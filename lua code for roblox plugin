-- ---------- İstemci başlatıcı (StarterPlayerScripts.AI_ClientRuntime çağırır) ----------
local started = false
function AIKit.StartClient()
	if IS_SERVER or started then return end
	started = true
	local player = Players.LocalPlayer

	if remote then
		remote.OnClientEvent:Connect(function(kind, a, b, c)
			if kind == "anim" then AIKit.PlayAnim(a, b, c)
			elseif kind == "stopanim" then AIKit.StopAnim(a, b, c)
			elseif kind == "shake" then AIKit.Shake(a, b)
			elseif kind == "fov" then AIKit.FovPunch(a, b)
			elseif kind == "blur" then AIKit.Blur(a, b)
			end
		end)
	end

	-- NPC yürüme / koşma / bekleme animasyonları (pozisyon farkından hız ölçülür)
	local loco = {}
	local function addLoco(model)
		if loco[model] or not model:IsA("Model") then return end
		loco[model] = {current = nil, lastPos = nil, speed = 0}
	end
	for _, m in ipairs(CollectionService:GetTagged("AI_Locomotion")) do addLoco(m) end
	CollectionService:GetInstanceAddedSignal("AI_Locomotion"):Connect(addLoco)
	CollectionService:GetInstanceRemovedSignal("AI_Locomotion"):Connect(function(m) loco[m] = nil end)

