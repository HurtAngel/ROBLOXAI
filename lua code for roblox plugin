-- GELİŞMİŞ SAHNE DURUMU TARAYICISI (SCENE CONTEXT SCANNER)
local function collectSceneHierarchy()
	local hierarchy = { StarterGui = {}, Workspace = {}, ReplicatedStorage = {}, ServerScriptService = {} }
	for _, gui in ipairs(StarterGui:GetChildren()) do
		local item = { Name = gui.Name, Class = gui.ClassName, Path = gui:GetFullName(), Children = {} }
		if gui:IsA("ScreenGui") then item.Enabled = gui.Enabled end
		for _, sub in ipairs(gui:GetChildren()) do
			if #item.Children < 15 then
				local subInfo = { Name = sub.Name, Class = sub.ClassName, Path = sub:GetFullName() }
				if sub:IsA("GuiObject") then subInfo.Visible = sub.Visible end
				table.insert(item.Children, subInfo)
			end
		end
		table.insert(hierarchy.StarterGui, item)
	end
	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name ~= "Camera" and child.Name ~= "Terrain" and #hierarchy.Workspace < 45 then
			local info = { Name = child.Name, Class = child.ClassName, Path = child:GetFullName() }
			if child:IsA("Model") or child:IsA("Tool") then
				info.IsRig = (child:FindFirstChildOfClass("Humanoid") ~= nil) or (child:FindFirstChildWhichIsA("Motor6D", true) ~= nil)
				info.ChildCount = #child:GetChildren()
			end
			table.insert(hierarchy.Workspace, info)
		end
	end
	for _, child in ipairs(ReplicatedStorage:GetChildren()) do
		if #hierarchy.ReplicatedStorage < 30 then
			table.insert(hierarchy.ReplicatedStorage, { Name = child.Name, Class = child.ClassName, Path = child:GetFullName() })
		end
	end
	for _, child in ipairs(ServerScriptService:GetChildren()) do
		if #hierarchy.ServerScriptService < 30 then
			table.insert(hierarchy.ServerScriptService, { Name = child.Name, Class = child.ClassName, Path = child:GetFullName() })
		end
	end
	return hierarchy
end

local function gatherSelectedContext()
	local selectedList = {}
	for _, sel in ipairs(Selection:Get()) do
		local info = { Name = sel.Name, Class = sel.ClassName, Path = sel:GetFullName() }
		if sel:IsA("BasePart") then
			info.Position = {sel.Position.X, sel.Position.Y, sel.Position.Z}
			info.Size = {sel.Size.X, sel.Size.Y, sel.Size.Z}
		elseif sel:IsA("ScreenGui") then
			info.Enabled = sel.Enabled
		elseif sel:IsA("GuiObject") then
			info.Visible = sel.Visible
		elseif sel:IsA("LuaSourceContainer") then
			info.Source = string.sub(sel.Source, 1, 20000)
		elseif sel:IsA("Model") then
			local joints = {}
			for _, d in ipairs(sel:GetDescendants()) do
				if d:IsA("Motor6D") and d.Part0 and d.Part1 then
					table.insert(joints, { JointName = d.Name, Part0 = d.Part0.Name, Part1 = d.Part1.Name })
				end
			end
			if #joints > 0 then info.RigJoints = joints end
		end
		table.insert(selectedList, info)
	end
	return selectedList
end

local function resolveOrSearchPath(pathStr)
	if not pathStr or pathStr == "" then return nil end
	local services = {
		Workspace = workspace, StarterGui = StarterGui, ServerScriptService = ServerScriptService,
		ServerStorage = ServerStorage, ReplicatedStorage = ReplicatedStorage,
		Lighting = game:GetService("Lighting"), StarterPack = game:GetService("StarterPack"), StarterPlayer = StarterPlayer
	}
	local parts = string.split(pathStr, ".")
	local current = services[parts[1]] or game
	for i = (services[parts[1]] and 2 or 1), #parts do
		local found = current:FindFirstChild(parts[i])
		if found then current = found else current = nil break end
	end
	if current then return current end
	return game:FindFirstChild(parts[#parts], true)
end

local function parseColor3(val, def)
	if type(val) == "table" and #val >= 3 then
		local r = tonumber(val[1]) or 0
		local g = tonumber(val[2]) or 0
		local b = tonumber(val[3]) or 0
		if r >= 0 and g >= 0 and b >= 0 and r <= 1 and g <= 1 and b <= 1 then
			r, g, b = r * 255, g * 255, b * 255
		end
		return Color3.fromRGB(math.clamp(math.round(r), 0, 255), math.clamp(math.round(g), 0, 255), math.clamp(math.round(b), 0, 255))
	end
	return def
end

local function convertProp(propName, val, obj)
	local low = string.lower(tostring(propName or ""))
	local isVfx = obj and (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam"))
	if isVfx then
		if low == "color" and type(val) == "table" and #val >= 3 then
			return ColorSequence.new(parseColor3(val, Color3.fromRGB(255, 255, 255)))
		elseif (low == "size" or low == "transparency") and type(val) == "number" then
			return NumberSequence.new(val)
		elseif (low == "size" or low == "transparency") and type(val) == "table" and #val == 2 then
			return NumberSequence.new(tonumber(val[1]) or 0, tonumber(val[2]) or 0)
		elseif (low == "lifetime" or low == "speed" or low == "rotspeed" or low == "rotation") then
			if type(val) == "number" then return NumberRange.new(val)
			elseif type(val) == "table" and #val >= 2 then return NumberRange.new(tonumber(val[1]) or 0, tonumber(val[2]) or 1) end
		end
	end
	if type(val) == "table" then
		if #val == 4 then return UDim2.new(val[1], val[2], val[3], val[4]) end
		if #val == 3 then
			if string.find(low, "color") or low == "ambient" or low == "outdoorambient" or low == "decay" then
				return parseColor3(val, Color3.fromRGB(255, 255, 255))
			end
			return Vector3.new(val[1], val[2], val[3])
		end
		if #val == 2 then
			if low == "anchorpoint" or low == "spreadangle" then return Vector2.new(val[1], val[2]) end
			return UDim.new(val[1], val[2])
		end
	elseif type(val) == "string" then
		if propName == "Material" and Enum.Material[val] then return Enum.Material[val] end
		if propName == "Font" and Enum.Font[val] then return Enum.Font[val] end
		if propName == "Shape" and Enum.PartType[val] then return Enum.PartType[val] end
		if propName == "TextXAlignment" and Enum.TextXAlignment[val] then return Enum.TextXAlignment[val] end
		if propName == "TextYAlignment" and Enum.TextYAlignment[val] then return Enum.TextYAlignment[val] end
		if propName == "FillDirection" and Enum.FillDirection[val] then return Enum.FillDirection[val] end
		if propName == "HorizontalAlignment" and Enum.HorizontalAlignment[val] then return Enum.HorizontalAlignment[val] end
		if propName == "VerticalAlignment" and Enum.VerticalAlignment[val] then return Enum.VerticalAlignment[val] end
		if propName == "SortOrder" and Enum.SortOrder[val] then return Enum.SortOrder[val] end
		if propName == "KeyboardKeyCode" and Enum.KeyCode[val] then return Enum.KeyCode[val] end
		if propName == "DepthMode" and Enum.HighlightDepthMode[val] then return Enum.HighlightDepthMode[val] end
	end
	return val
end

-- OTOMATİK SÖZDİZİMİ (SYNTAX) ÖN KONTROLÜ
local function validateActionsSyntax(actions)
	local errs = {}
	for idx, act in ipairs(actions or {}) do
		local t = act.type
		if (t == "write_script" or t == "edit_script") and act.source and act.source ~= "" then
			local fn, err = loadstring(act.source)
			if not fn then
				table.insert(errs, string.format("Aksiyon #%d (%s): %s", idx, tostring(act.name or act.path or "Script"), tostring(err)))
			end
		elseif t == "run_luau" and act.code and act.code ~= "" then
			local fn, err = loadstring(act.code)
			if not fn then
				table.insert(errs, string.format("Aksiyon #%d (run_luau): %s", idx, tostring(err)))
			end
		end
	end
	return errs
end

local function findTargetRig(rigPath)
	if rigPath and rigPath ~= "" then
		local obj = resolveOrSearchPath(rigPath)
		if obj and obj:IsA("Model") then return obj end
	end
	for _, sel in ipairs(Selection:Get()) do
		if sel:IsA("Model") and sel:FindFirstChildOfClass("Humanoid") then return sel end
	end
	return nil
end

