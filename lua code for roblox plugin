end

local function getAnimator(model)
	if not model then return nil end
	local holder = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("AnimationController")
	if not holder then return nil end
	local animator = holder:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = holder
	end
	return animator
end

local function getTrack(model, name)
	local tracks = trackCache[model]
	if not tracks then tracks = {}; trackCache[model] = tracks end
	if tracks[name] then return tracks[name] end
	local animator = getAnimator(model)
	local anim = animator and getAnimation(name)
	if not anim then return nil end
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if ok and track then
		tracks[name] = track
		return track
	end
	return nil
end

function AIKit.PlayAnim(target, name, opts)
	opts = opts or {}
	if IS_SERVER then
		fire("anim", nil, resolve(target) or target, name, opts)
		return nil
	end
	local model = resolve(target)
	if not model then return nil end
	local track = getTrack(model, name)
	if not track then return nil end
	if opts.priority and Enum.AnimationPriority[opts.priority] then track.Priority = Enum.AnimationPriority[opts.priority] end
	if opts.looped ~= nil then track.Looped = opts.looped end
	track:Play(opts.fade or 0.12, opts.weight or 1, opts.speed or 1)
	return track
end

function AIKit.StopAnim(target, name, fade)
	if IS_SERVER then
		fire("stopanim", nil, resolve(target) or target, name, fade)
		return
	end
	local model = resolve(target)
	local tracks = model and trackCache[model]
	if not tracks then return end
	if name and tracks[name] then
		tracks[name]:Stop(fade or 0.15)
	elseif not name then
		for _, tr in pairs(tracks) do tr:Stop(fade or 0.15) end
	end
end

