-- Semantik kareyi (ileri/yana/bükme açıları) gerçek R15/R6 eklem pozlarına çevirir.
local function presetFrameToPoses(fr, isR6, k)
	k = k or 1
	local z = {0, 0, 0}
	local ra, la, rl, ll = fr.ra or z, fr.la or z, fr.rl or z, fr.ll or z
	local y, lean, twist = (fr.y or 0), (fr.lean or 0) * k, (fr.twist or 0) * k
	local head, headTurn = (fr.head or 0) * k, (fr.headTurn or 0) * k
	local poses = {}
	if isR6 then
		poses["Torso"] = {pos = {0, 0, y}, rot = {lean, 0, twist}}
		poses["Head"] = {rot = {head, 0, headTurn}}
		poses["Right Arm"] = {rot = {-ra[2] * k, 0, ra[1] * k}}
		poses["Left Arm"] = {rot = {-la[2] * k, 0, -la[1] * k}}
		poses["Right Leg"] = {rot = {0, 0, rl[1] * k}}
		poses["Left Leg"] = {rot = {0, 0, -ll[1] * k}}
	else
		poses["LowerTorso"] = {pos = {0, y, 0}, rot = {-lean, 0, 0}}
		poses["UpperTorso"] = {rot = {0, twist, 0}}
		poses["Head"] = {rot = {-head, headTurn, 0}}
		poses["RightUpperArm"] = {rot = {ra[1] * k, 0, ra[2] * k}}
		poses["LeftUpperArm"] = {rot = {la[1] * k, 0, -la[2] * k}}
		poses["RightLowerArm"] = {rot = {ra[3] * k, 0, 0}}
		poses["LeftLowerArm"] = {rot = {la[3] * k, 0, 0}}
		poses["RightUpperLeg"] = {rot = {rl[1] * k, 0, 0}}
		poses["LeftUpperLeg"] = {rot = {ll[1] * k, 0, 0}}
		poses["RightLowerLeg"] = {rot = {-rl[3] * k, 0, 0}}
		poses["LeftLowerLeg"] = {rot = {-ll[3] * k, 0, 0}}
	end
	return poses
end

local function buildPresetKeyframes(presetName, isR6, speed, intensity)
	local preset = AIKIT_PRESETS[string.lower(tostring(presetName or ""))]
	if not preset then return nil end
	speed = tonumber(speed) or 1
	if speed <= 0 then speed = 1 end
	local out = {}
	for _, fr in ipairs(preset.frames) do
		table.insert(out, {time = (fr.t or 0) / speed, poses = presetFrameToPoses(fr, isR6, tonumber(intensity) or 1)})
	end
	return out, preset
end

