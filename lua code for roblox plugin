function AIKit.GetAnimLength(name)
	local folder = ReplicatedStorage:FindFirstChild("AI_Animations")
	local kfs = folder and folder:FindFirstChild(name)
	if not kfs then return 0 end
	local maxT = 0
	for _, kf in ipairs(kfs:GetChildren()) do
