local function formatProjectNotesText(notes, questions, assistantMsg, previewActive, previewSkipped)
	local lines = {}
	if assistantMsg and assistantMsg ~= "" then
		table.insert(lines, "💬 " .. tostring(assistantMsg))
	end
	if type(questions) == "table" and #questions > 0 then
		table.insert(lines, "\n❓ SORULAR (Aşağıdaki kutuya cevap yazıp '💬 Cevapları Gönder'e bas):")
		for _, q in ipairs(questions) do
			table.insert(lines, "  " .. tostring(q))
		end
	end
	if type(notes) == "table" and next(notes) ~= nil then
		table.insert(lines, "\n📋 PROJE NOTLARI (PROJECT_NOTES):")
		if notes.game_title and notes.game_title ~= "" then table.insert(lines, "  • Başlık: " .. tostring(notes.game_title)) end
		if notes.core_concept and notes.core_concept ~= "" then table.insert(lines, "  • Konsept: " .. tostring(notes.core_concept)) end
		if notes.camera_preference and notes.camera_preference ~= "" then table.insert(lines, "  • Kamera: " .. tostring(notes.camera_preference)) end
		if notes.atmosphere_theme and notes.atmosphere_theme ~= "" then table.insert(lines, "  • Atmosfer: " .. tostring(notes.atmosphere_theme)) end
		if notes.win_lose_conditions and notes.win_lose_conditions ~= "" then table.insert(lines, "  • Kazanma/Kaybetme: " .. tostring(notes.win_lose_conditions)) end
		if type(notes.confirmed_features) == "table" and #notes.confirmed_features > 0 then
			table.insert(lines, "  • Kesin Özellikler: " .. table.concat(notes.confirmed_features, " | "))
		end
		if type(notes.controls_and_mechanics) == "table" and #notes.controls_and_mechanics > 0 then
			table.insert(lines, "  • Kontroller/Mekanik: " .. table.concat(notes.controls_and_mechanics, " | "))
		end
		if type(notes.negative_constraints) == "table" and #notes.negative_constraints > 0 then
			table.insert(lines, "  🚫 KESİN YASAKLAR: " .. table.concat(notes.negative_constraints, " | "))
		end
	end
	if type(previewActive) == "table" and #previewActive > 0 then
		table.insert(lines, "\n✅ Planlanan Aktif Agent'lar: " .. table.concat(previewActive, ", "))
	end
	if type(previewSkipped) == "table" and next(previewSkipped) ~= nil then
		local skipList = {}
		for k, v in pairs(previewSkipped) do
			table.insert(skipList, tostring(k) .. " (" .. tostring(v) .. ")")
		end
		table.insert(lines, "⏭️ Pas Geçilecekler (PASS): " .. table.concat(skipList, ", "))
	end
	return table.concat(lines, "\n")
end

local function formatAgentPipelineSummary(pipeline, handoffs)
	if type(pipeline) ~= "table" or #pipeline == 0 then return "" end
	local iconMap = {
		running = "🔄 ÇALIŞIYOR",
		done = "✅ TAMAM",
		pass = "⏭️ PASS",
		active = "⏳ AKTİF",
		pending = "· BEKLİYOR",
		error = "❌ HATA",
	}
	local lines = { "=== 15-AGENT BORU HATTI ÖZETİ ===" }
	for _, p in ipairs(pipeline) do
		local st = iconMap[p.status] or tostring(p.status)
		local extra = ""
		if p.status == "done" then
			extra = string.format(" (%d aksiyon)", tonumber(p.actions_count) or 0)
		elseif p.status == "pass" and p.reason and p.reason ~= "" then
			extra = " — " .. tostring(p.reason)
		end
		table.insert(lines, string.format("  %s: %s%s", tostring(p.title or p.id), st, extra))
	end
	if type(handoffs) == "table" and #handoffs > 0 then
		table.insert(lines, "\n🔗 SHARED_MANIFEST VERİ AKTARIMLARI:")
		for _, h in ipairs(handoffs) do
			table.insert(lines, "  • " .. tostring(h))
		end
	end
	return table.concat(lines, "\n")
end

local function runAgentWorkflow(customPrompt, extraFiles, stepCount, syntaxRetries, skipExpand, notesOverride, sessionOverride, convOverride)
	stepCount = stepCount or 1
	syntaxRetries = syntaxRetries or 0
	if stepCount > 6 then
		logBox.Text = "Maksimum ajan adımına (6) ulaşıldı."
		setIdleButtons()
		return
	end

	local notesToSend = notesOverride or activeProjectNotes or {}
	local sessionToSend = sessionOverride or activeDiscoverySessionId or ""
	local convToSend = convOverride or activeDiscoveryConversation or {}

	if expandPromptEnabled and stepCount == 1 and syntaxRetries == 0 and not skipExpand then
		runBtn.Text = "✨ Zenginleştiriliyor..."
		logBox.Text = "✨ Prompt Zenginleştirici çalışıyor (4 başlıklı teknik oyun tasarımı üretiliyor)..."
		local expOk, expRes = pcall(function()
			return HttpService:RequestAsync({
				Url = DEFAULT_URL .. "/expand-prompt",
				Method = "POST",
				Headers = getHeaders(true),
				Body = HttpService:JSONEncode({ prompt = customPrompt })
			})
		end)
		if expOk and expRes and expRes.Success then
			local decOk, expData = pcall(function() return HttpService:JSONDecode(expRes.Body) end)
			if decOk and type(expData) == "table" and expData.expanded_prompt and expData.expanded_prompt ~= "" then
				customPrompt = expData.expanded_prompt
				logBox.Text = string.format("✨ Zenginleştirilmiş Tasarım (%s):\n\n%s\n\n⏳ 15-Agent üretim hattı başlatılıyor...", tostring(expData.model or "expander"), customPrompt)
			else
				logBox.Text = "⚠️ Zenginleştirici yanıtı çözümlenemedi, orijinal prompt ile devam ediliyor..."
			end
		else
			logBox.Text = "⚠️ Prompt Zenginleştirici ulaşılamadı, orijinal prompt ile devam ediliyor..."
		end
		runBtn.Text = "Üretiliyor..."
	end

	local body = HttpService:JSONEncode({
		prompt = customPrompt,
		session_id = sessionToSend,
		project_notes = notesToSend,
		discovery_conversation = convToSend,
		thinking_mode = thinkingMode,
		is_syntax_repair = syntaxRetries > 0,
		directives = {
			auto_mode = autoMode,
			req_anim = manualRules.req_anim,
			req_cam = manualRules.req_cam,
			req_vfx = manualRules.req_vfx,
			req_weapon = manualRules.req_weapon
		},
		selected_items = gatherSelectedContext(),
		project_shortened_index = collectShortenedIndex(),
		scene_hierarchy = collectSceneHierarchy(),
		requested_files_content = extraFiles or {}
	})

	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = DEFAULT_URL .. "/agent/execute",
			Method = "POST",
			Headers = getHeaders(true),
			Body = body
		})
	end)

	if not ok or not res.Success then
		logBox.Text = "Hata: " .. tostring(res and res.Body or res)
		setIdleButtons()
		return
	end

	local startData = HttpService:JSONDecode(res.Body)
	if startData.error then
		logBox.Text = "Hata: " .. startData.error
		setIdleButtons()
		return
	end

	local taskId = startData.task_id
	local polling = true
	resetAgentGrid()

	task.spawn(function()
		while polling do
			task.wait(0.8)
			local pOk, pRes = pcall(function()
				return HttpService:RequestAsync({
					Url = DEFAULT_URL .. "/agent/poll?task_id=" .. taskId,
					Method = "GET",
					Headers = getHeaders(false)
				})
			end)

			if pOk and pRes.Success then
				local pData = HttpService:JSONDecode(pRes.Body)
				if pData.agent_pipeline then updateAgentGrid(pData.agent_pipeline) end
				logBox.Text = string.format("Adım %d | Durum: %s\n\n%s", stepCount, tostring(pData.status), tostring(pData.buffer or ""))

				if pData.status == "completed" then
					polling = false
					local result = pData.result or {}
					updateAgentGrid(result.agent_pipeline or pData.agent_pipeline)
					local needFiles = result.need_files or {}

					if #needFiles > 0 then
						local loadedFiles = extraFiles or {}
						local newlyLoaded = 0
						for _, fPath in ipairs(needFiles) do
							if not loadedFiles[fPath] then
								local targetObj = resolveOrSearchPath(fPath)
								if targetObj and targetObj:IsA("LuaSourceContainer") then
									loadedFiles[fPath] = string.sub(targetObj.Source, 1, 22000)
									newlyLoaded = newlyLoaded + 1
								else
									loadedFiles[fPath] = "-- [DOSYA BULUNAMADI]"
								end
							end
						end
						if newlyLoaded > 0 then
							logBox.Text = "Model ilgili dosyaları okuyor (" .. table.concat(needFiles, ", ") .. ")..."
							runAgentWorkflow(customPrompt, loadedFiles, stepCount + 1, syntaxRetries, true, notesToSend, sessionToSend, convToSend)
							return
						end
					end

					-- OTOMATİK SÖZDİZİMİ (SYNTAX) ÖN KONTROLÜ
					local syntaxErrs = validateActionsSyntax(result.actions or {})
					if #syntaxErrs > 0 and syntaxRetries < 2 then
						logBox.Text = "⚠️ Sözdizimi hatası yakalandı, sahne bozulmadan arka planda sessizce onarılıyor...\n" .. table.concat(syntaxErrs, "\n")
						local repairPrompt = customPrompt .. "\n\n[OTOMATİK SYNTAX ONARIMI]: Az önce ürettiğin Luau kodunda şu sözdizimi hataları tespit edildi, lütfen tüm hataları düzeltip temiz JSON döndür:\n" .. table.concat(syntaxErrs, "\n")
						runAgentWorkflow(repairPrompt, extraFiles, stepCount + 1, syntaxRetries + 1, true, notesToSend, sessionToSend, convToSend)
						return
					end

					local report = executeActions(result.actions or {})
					local pipeSummary = formatAgentPipelineSummary(result.agent_pipeline or pData.agent_pipeline, result.handoff_logs or pData.handoff_logs)
					logBox.Text = pipeSummary .. "\n\n[UYGULANAN STUDIO AKSİYONLARI]\n" .. report .. "\n\n[ÖZET]\n" .. tostring(result.thought or "") .. "\n\n✅ Tamamlandı."
					resetDiscoveryState()
					verifyAccount()

				elseif pData.status == "failed" then
					polling = false
					logBox.Text = "Hata: " .. tostring(pData.error)
					setIdleButtons()
				end
			end
		end
	end)
end

local function runDiscoveryStep(inputText)
	runBtn.Text = "🧭 Analiz Ediliyor..."
	runBtn.BackgroundColor3 = C.CARD
	logBox.Text = "🧭 Main Agent isteğini analiz ediyor, sorular ve Proje Notları hazırlanıyor..."

	if not activeDiscoverySessionId then
		activeInitialPrompt = inputText
	end

	local body = HttpService:JSONEncode({
		prompt = inputText,
		session_id = activeDiscoverySessionId or "",
		project_notes = activeProjectNotes or {},
		conversation = activeDiscoveryConversation or {},
		scene_hierarchy = collectSceneHierarchy(),
		selected_items = gatherSelectedContext(),
		thinking_mode = thinkingMode
	})

	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = DEFAULT_URL .. "/agent/discover",
			Method = "POST",
			Headers = getHeaders(true),
			Body = body
		})
	end)

	if not ok or not res or not res.Success then
		logBox.Text = "⚠️ Keşif servisine ulaşılamadı (" .. tostring(res and res.Body or res) .. "). Doğrudan 15-Agent üretimine geçiliyor..."
		runAgentWorkflow(activeInitialPrompt ~= "" and activeInitialPrompt or inputText, {}, 1, 0)
		return
	end

	local decOk, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not decOk or type(data) ~= "table" or data.error then
		logBox.Text = "⚠️ Keşif hatası: " .. tostring(type(data) == "table" and data.error or "JSON hatası")
		setIdleButtons()
		return
	end

	activeDiscoverySessionId = data.session_id
	activeProjectNotes = type(data.project_notes) == "table" and data.project_notes or activeProjectNotes
	activeDiscoveryConversation = type(data.conversation) == "table" and data.conversation or activeDiscoveryConversation

	local displayTxt = formatProjectNotesText(
		activeProjectNotes,
		data.questions,
		data.assistant_message or data.summary,
		data.preview_active_agents,
		data.preview_skipped_agents
	)
	discoveryCard.Visible = true
	setDiscoveryDisplay(displayTxt)
	promptBox.Text = ""

	if data.status == "ready" then
		logBox.Text = "✅ Proje Notları kesinleşti! Main Agent seçici yönlendirme ve 14 Alt Agent üretim hattını başlatıyor...\n\n" .. displayTxt
		runBtn.Text = "🚀 Üretiliyor..."
		runBtn.BackgroundColor3 = C.CARD
		local finalPrompt = activeInitialPrompt ~= "" and activeInitialPrompt or inputText
		lastSubmittedPrompt = finalPrompt
		runAgentWorkflow(finalPrompt, {}, 1, 0, false, activeProjectNotes, activeDiscoverySessionId, activeDiscoveryConversation)
	else
		logBox.Text = string.format("🧭 Keşif Turu %d (%s) tamamlandı.\nSoruların cevaplarını yukarıdaki komut kutusuna yazıp '💬 Cevapları Gönder' butonuna basabilir veya '⚡ Soruları Atla ve Üret' ile hemen başlatabilirsin.", tonumber(data.round) or 1, tostring(data.model or "main_agent"))
		setIdleButtons()
	end
end

