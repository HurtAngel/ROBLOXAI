local function updateAgentGrid(pipeline)
	if type(pipeline) ~= "table" then return end
	for _, p in ipairs(pipeline) do
		local info = agentGridCards[p.id]
		if info then
			local st = tostring(p.status or "pending")
			if st == "running" then
				info.card.BackgroundColor3 = Color3.fromRGB(28, 62, 118)
				info.card.TextColor3 = Color3.fromRGB(219, 234, 254)
				info.card.Text = "🔄 " .. info.label
			elseif st == "done" then
				info.card.BackgroundColor3 = Color3.fromRGB(20, 74, 52)
				info.card.TextColor3 = Color3.fromRGB(167, 243, 208)
				local cnt = tonumber(p.actions_count) or 0
				info.card.Text = cnt > 0 and string.format("✅ %s (%d)", info.label, cnt) or ("✅ " .. info.label)
			elseif st == "active" then
				info.card.BackgroundColor3 = Color3.fromRGB(68, 55, 22)
				info.card.TextColor3 = Color3.fromRGB(253, 230, 138)
				info.card.Text = "⏳ " .. info.label .. " [AKTİF]"
			elseif st == "pass" then
				info.card.BackgroundColor3 = Color3.fromRGB(24, 24, 29)
				info.card.TextColor3 = Color3.fromRGB(113, 113, 122)
				info.card.Text = "⏭️ " .. info.label .. " [PASS]"
			elseif st == "error" then
				info.card.BackgroundColor3 = Color3.fromRGB(102, 26, 34)
				info.card.TextColor3 = Color3.fromRGB(254, 202, 202)
				info.card.Text = "❌ " .. info.label
			else
				info.card.BackgroundColor3 = C.CARD
				info.card.TextColor3 = C.MUTED
				info.card.Text = "· " .. info.label
			end
		end
	end
end

