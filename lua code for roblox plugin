	retryBtn.Text = "🔄 Yeniden Dene"
	runBtn.Text = "Yeniden Üretiliyor..."
	runBtn.BackgroundColor3 = C.CARD
	logBox.Text = "🔄 Sahne ve hafıza geri alındı, son komut temiz hafızayla yeniden çalıştırılıyor..."
	runAgentWorkflow(lastSubmittedPrompt, {}, 1, 0)
end)

