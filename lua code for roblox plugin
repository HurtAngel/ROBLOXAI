local function validateActionsSyntax(actions)
	local errs = {}
	for idx, act in ipairs(actions or {}) do
		local t = act.type
		if (t == "write_script" or t == "edit_script") and act.source and act.source ~= "" then
			local fn, err = loadstring(act.source)
			if not fn then
				table.insert(errs, string.format("Aksiyon #%d (%s): %s", idx, tostring(act.name or act.path or "Script"), tostring(err)))
			end
		elseif t == "run_luau" and act.code and act.code ~= "" then
			local fn, err = loadstring(act.code)
			if not fn then
				table.insert(errs, string.format("Aksiyon #%d (run_luau): %s", idx, tostring(err)))
			end
		end
	end
	return errs
end

local function findTargetRig(rigPath)
	if rigPath and rigPath ~= "" then
		local obj = resolveOrSearchPath(rigPath)
		if obj and obj:IsA("Model") then return obj end
	end
	for _, sel in ipairs(Selection:Get()) do
		if sel:IsA("Model") and sel:FindFirstChildOfClass("Humanoid") then return sel end
	end
	return nil
end

local function buildKeyframeSequence(act)
	local folder = ServerStorage:FindFirstChild("AI_Animations") or Instance.new("Folder", ServerStorage)
	folder.Name = "AI_Animations"
	local targetRig = findTargetRig(act.rig_path)
	local parentMap = {}

	if targetRig then
		for _, d in ipairs(targetRig:GetDescendants()) do
			if d:IsA("Motor6D") and d.Part0 and d.Part1 then parentMap[d.Part1.Name] = d.Part0.Name end
		end
	else
		parentMap = {
			LowerTorso = "HumanoidRootPart", UpperTorso = "LowerTorso", Head = "UpperTorso",
			RightUpperArm = "UpperTorso", RightLowerArm = "RightUpperArm", RightHand = "RightLowerArm",
			LeftUpperArm = "UpperTorso", LeftLowerArm = "LeftUpperArm", LeftHand = "LeftLowerArm",
			RightUpperLeg = "LowerTorso", RightLowerLeg = "RightUpperLeg", RightFoot = "RightLowerLeg",
			LeftUpperLeg = "LowerTorso", LeftLowerLeg = "LeftUpperLeg", LeftFoot = "LeftLowerLeg",
			Torso = "HumanoidRootPart"
		}
	end

	local kfs = Instance.new("KeyframeSequence")
	kfs.Name = act.name or "AI_Animation"
	kfs.Loop = act.loop == true
	kfs.Priority = Enum.AnimationPriority[act.priority or "Action"] or Enum.AnimationPriority.Action

	for _, kfData in ipairs(act.keyframes or {}) do
		local kf = Instance.new("Keyframe")
		kf.Time = tonumber(kfData.time) or 0
		kf.Parent = kfs
		local poseNodes = {}
		local function ensurePose(partName)
			if poseNodes[partName] then return poseNodes[partName] end
			local p = Instance.new("Pose")
			p.Name = partName
			poseNodes[partName] = p
			if partName == "HumanoidRootPart" then p.Parent = kf
			else p.Parent = ensurePose(parentMap[partName] or "HumanoidRootPart") end
			return p
		end
		ensurePose("HumanoidRootPart")
		for partName, poseData in pairs(kfData.poses or {}) do
			local p = ensurePose(partName)
			local pos = poseData.pos or {0, 0, 0}
			local rot = poseData.rot or {0, 0, 0}
			p.CFrame = CFrame.new(pos[1] or 0, pos[2] or 0, pos[3] or 0) * CFrame.Angles(math.rad(rot[1] or 0), math.rad(rot[2] or 0), math.rad(rot[3] or 0))
			local easing = Enum.PoseEasingStyle[poseData.easing or "Cubic"]
			if easing then p.EasingStyle = easing end
		end
	end

	kfs.Parent = folder
	if targetRig then
		local animSaves = targetRig:FindFirstChild("AnimSaves") or Instance.new("Model", targetRig)
		animSaves.Name = "AnimSaves"
		kfs:Clone().Parent = animSaves
	end
	return kfs, targetRig
end

