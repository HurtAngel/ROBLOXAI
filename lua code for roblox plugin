	local startIdx = 1
	if parts[1] == "Workspace" or parts[1] == "workspace" then cur = workspace; startIdx = 2 end
	for i = startIdx, #parts do cur = cur and cur:FindFirstChild(parts[i]) end
	if cur and cur ~= game then return cur end
	return workspace:FindFirstChild(parts[#parts], true)
end

local function clampAxis(val, homeVal, attr)
	if attr == nil then return val end
	local t = typeof(attr)
	if t == "NumberRange" then
		return math.clamp(val, attr.Min, attr.Max)
	elseif t == "Vector2" then
		return math.clamp(val, math.min(attr.X, attr.Y), math.max(attr.X, attr.Y))
	elseif t == "number" then
		local r = math.abs(attr)
		return math.clamp(val, homeVal - r, homeVal + r)
	elseif t == "string" then
		local ok, arr = pcall(function() return HttpService:JSONDecode(attr) end)
		if ok and type(arr) == "table" and #arr >= 2 then
			local a, b = tonumber(arr[1]), tonumber(arr[2])
			if a and b then return math.clamp(val, math.min(a, b), math.max(a, b)) end
		end
		local parts = string.split(attr, ",")
		if #parts >= 2 then
			local a, b = tonumber(parts[1]), tonumber(parts[2])
			if a and b then return math.clamp(val, math.min(a, b), math.max(a, b)) end
		end
	end
	return val
end

local function step(model, hum, root, state)
	local behavior = model:GetAttribute("AI_Behavior") or "idle"
	if behavior == "wander" then
		local r = math.max(4, math.floor(model:GetAttribute("AI_WanderRadius") or 25))
		hum:MoveTo(state.home + Vector3.new(math.random(-r, r), 0, math.random(-r, r)))
		hum.MoveToFinished:Wait()
		task.wait(math.random(8, 25) / 10)
	elseif behavior == "patrol" then
		local okJ, pts = pcall(function() return HttpService:JSONDecode(model:GetAttribute("AI_Patrol") or "[]") end)
		if okJ and type(pts) == "table" and #pts > 0 then
			local p = pts[(state.patrolIndex - 1) % #pts + 1]
			state.patrolIndex += 1
			hum:MoveTo(Vector3.new(p[1] or 0, p[2] or 0, p[3] or 0))
			hum.MoveToFinished:Wait()
			task.wait(0.4)
		else
			task.wait(1)
		end
	elseif behavior == "follow_player" or behavior == "follow_target" then
		local targetPos = nil
		if behavior == "follow_target" then
			local obj = resolvePath(model:GetAttribute("AI_TargetPath"))
			if obj and obj:IsA("BasePart") then targetPos = obj.Position
			elseif obj and obj:IsA("Model") then targetPos = obj:GetPivot().Position end
		else
			local char = nearestCharacter(root.Position, model:GetAttribute("AI_SightRange") or 80)
			if char then targetPos = char.HumanoidRootPart.Position end
		end
		local rx, rz = model:GetAttribute("RestrictX"), model:GetAttribute("RestrictZ")
		local hasRestrict = (rx ~= nil or rz ~= nil)
		if targetPos then
			if hasRestrict then
				targetPos = Vector3.new(clampAxis(targetPos.X, state.home.X, rx), root.Position.Y, clampAxis(targetPos.Z, state.home.Z, rz))
			end
			local stopDist = model:GetAttribute("AI_FollowDistance") or (hasRestrict and 1.5 or 5)
			local flatDist = Vector3.new(targetPos.X - root.Position.X, 0, targetPos.Z - root.Position.Z).Magnitude
			if flatDist > stopDist then
				hum:MoveTo(targetPos)
			else
				hum:MoveTo(root.Position)
			end
		else
			local homePos = state.home
			if hasRestrict then
				homePos = Vector3.new(clampAxis(homePos.X, state.home.X, rx), root.Position.Y, clampAxis(homePos.Z, state.home.Z, rz))
			end
			hum:MoveTo(homePos)
		end
		task.wait(0.15)
	else
		task.wait(0.5)
	end
end

local function run(model)
	if brains[model] or not model:IsA("Model") then return end
	brains[model] = true
	task.spawn(function()
		local hum = model:WaitForChild("Humanoid", 10)
		local root = model:WaitForChild("HumanoidRootPart", 10)
		if not hum or not root then brains[model] = nil return end
		if model:GetAttribute("AI_Behavior") ~= "idle" then root.Anchored = false end
		pcall(function() root:SetNetworkOwner(nil) end)
		local state = {home = root.Position, patrolIndex = 1}
		while model.Parent and hum.Health > 0 do
			local ok, err = pcall(step, model, hum, root, state)
			if not ok then
				warn("[AI_NPCBrain] " .. model.Name .. ": " .. tostring(err))
				task.wait(1)
			end
		end
		brains[model] = nil
	end)
end

for _, m in ipairs(CollectionService:GetTagged("AI_NPC")) do run(m) end
CollectionService:GetInstanceAddedSignal("AI_NPC"):Connect(run)
