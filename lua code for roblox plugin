-- ---------- İstemci animasyon motoru ----------
local animCache = {}
local trackCache = setmetatable({}, {__mode = "k"})

local function getAnimation(name)
	if animCache[name] then return animCache[name] end
	local folder = ReplicatedStorage:FindFirstChild("AI_Animations") or ReplicatedStorage:WaitForChild("AI_Animations", 5)
	local src = folder and folder:FindFirstChild(name)
	if not src then
		warn("[AIKit] Animasyon bulunamadı: ReplicatedStorage.AI_Animations." .. tostring(name))
		return nil
	end
	local anim = Instance.new("Animation")
	anim.Name = name
	local assetId = src:GetAttribute("AssetId")
	if src:IsA("Animation") then
		anim.AnimationId = src.AnimationId
	elseif assetId and tostring(assetId) ~= "" and tostring(assetId) ~= "0" then
		anim.AnimationId = "rbxassetid://" .. (string.gsub(tostring(assetId), "%D", ""))
	elseif src:IsA("KeyframeSequence") then
		local ok, id = pcall(function()
			return game:GetService("KeyframeSequenceProvider"):RegisterKeyframeSequence(src)
		end)
		if not ok then
			warn("[AIKit] RegisterKeyframeSequence hatası: " .. tostring(id))
			return nil
		end
		anim.AnimationId = id
	end
