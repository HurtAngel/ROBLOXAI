local R6_PARENT_MAP = {
	Torso = "HumanoidRootPart", Head = "Torso",
	["Right Arm"] = "Torso", ["Left Arm"] = "Torso", ["Right Leg"] = "Torso", ["Left Leg"] = "Torso",
}

local function rigIsR6(rig, fallbackType)
	if rig then
		local hum = rig:FindFirstChildOfClass("Humanoid")
		if hum then return hum.RigType == Enum.HumanoidRigType.R6 end
		if rig:FindFirstChild("Torso") and not rig:FindFirstChild("UpperTorso") then return true end
		return false
	end
	return string.upper(tostring(fallbackType or "R15")) == "R6"
end

-- create_animation: preset VEYA özel keyframe'lerden KeyframeSequence üretir (ReplicatedStorage.AI_Animations)
local function buildKeyframeSequence(act)
	ensureKit()
	local folder = ReplicatedStorage:FindFirstChild("AI_Animations")
	local targetRig = findTargetRig(act.rig_path)
	local isR6 = rigIsR6(targetRig, act.rig_type)
	local parentMap = {}
	if targetRig then
		for _, d in ipairs(targetRig:GetDescendants()) do
			if d:IsA("Motor6D") and d.Part0 and d.Part1 then parentMap[d.Part1.Name] = d.Part0.Name end
		end
	end
	for k, v in pairs(isR6 and R6_PARENT_MAP or R15_PARENT_MAP) do
		if not parentMap[k] then parentMap[k] = v end
	end

	local keyframes = act.keyframes
	local presetInfo = nil
	if act.preset and act.preset ~= "" then
		local generated, info = buildPresetKeyframes(act.preset, isR6, act.speed, act.intensity)
		if generated then keyframes, presetInfo = generated, info end
	end
	keyframes = keyframes or {}
	if #keyframes == 0 then
		local generated, info = buildPresetKeyframes("idle", isR6, 1, 1)
		keyframes, presetInfo = generated, info
	end

	local animName = act.name or (act.preset and ("AI_" .. tostring(act.preset))) or "AI_Animation"
	for _, old in ipairs(folder:GetChildren()) do
		if old.Name == animName then old:Destroy() end
	end

	local kfs = Instance.new("KeyframeSequence")
	kfs.Name = animName
	local loop = act.loop
	if loop == nil and presetInfo then loop = presetInfo.loop end
	kfs.Loop = loop == true
	local prio = act.priority or (presetInfo and presetInfo.priority) or "Action"
	kfs.Priority = Enum.AnimationPriority[prio] or Enum.AnimationPriority.Action
	kfs:SetAttribute("RigType", isR6 and "R6" or "R15")

	for _, kfData in ipairs(keyframes) do
		local kf = Instance.new("Keyframe")
		kf.Time = tonumber(kfData.time) or 0
		kf.Parent = kfs
		local poseNodes = {}
		local function ensurePose(partName)
			if poseNodes[partName] then return poseNodes[partName] end
			local p = Instance.new("Pose")
			p.Name = partName
			poseNodes[partName] = p
			if partName == "HumanoidRootPart" then p.Parent = kf
			else p.Parent = ensurePose(parentMap[partName] or "HumanoidRootPart") end
			return p
		end
		ensurePose("HumanoidRootPart")
		for partName, poseData in pairs(kfData.poses or {}) do
			local p = ensurePose(partName)
			local pos = poseData.pos or {0, 0, 0}
			local rot = poseData.rot or {0, 0, 0}
			p.CFrame = CFrame.new(pos[1] or 0, pos[2] or 0, pos[3] or 0) * CFrame.Angles(math.rad(rot[1] or 0), math.rad(rot[2] or 0), math.rad(rot[3] or 0))
			local easing = Enum.PoseEasingStyle[poseData.easing or kfData.easing or "Cubic"]
			if easing then p.EasingStyle = easing end
		end
	end

	kfs.Parent = folder
	if targetRig and act.save_to_rig ~= false then
		local animSaves = targetRig:FindFirstChild("AnimSaves") or Instance.new("Model", targetRig)
		animSaves.Name = "AnimSaves"
		local oldSave = animSaves:FindFirstChild(animName)
		if oldSave then oldSave:Destroy() end
		kfs:Clone().Parent = animSaves
	end
	return kfs, targetRig
end

-- Paylaşılan hareket animasyonlarını (AI_R15_Walk vb.) yoksa üretir
local function ensureLocomotionAnim(isR6, presetName)
	local folder = ReplicatedStorage:FindFirstChild("AI_Animations")
	local name = string.format("AI_%s_%s", isR6 and "R6" or "R15", presetName:sub(1, 1):upper() .. presetName:sub(2))
	if not (folder and folder:FindFirstChild(name)) then
		buildKeyframeSequence({name = name, preset = presetName, rig_type = isR6 and "R6" or "R15", save_to_rig = false})
	end
	return name
end

local function toColor(v, def)
	if type(v) == "table" and #v >= 3 then return Color3.fromRGB(v[1], v[2], v[3]) end
	return def
end

-- spawn_rig: resmi rig + renk + animasyon + davranış (tek aksiyonda hazır, yürüyen NPC)
local function spawnRig(act)
	ensureKit()
	local isR6 = string.upper(tostring(act.rig_type or "R15")) == "R6"
	local rnd = Random.new()
	local skins = {
		Color3.fromRGB(255, 220, 185), Color3.fromRGB(234, 192, 160), Color3.fromRGB(204, 142, 105),
		Color3.fromRGB(160, 105, 75), Color3.fromRGB(110, 72, 50), Color3.fromRGB(245, 205, 165),
	}
	local skin = toColor(act.skin_color, skins[rnd:NextInteger(1, #skins)])
	local shirt = toColor(act.shirt_color, Color3.fromHSV(rnd:NextNumber(), 0.65, 0.85))
	local pants = toColor(act.pants_color, Color3.fromHSV(rnd:NextNumber(), 0.35, 0.35))

	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = shirt
	desc.LeftLegColor = pants
	desc.RightLegColor = pants

	local ok, rig = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, isR6 and Enum.HumanoidRigType.R6 or Enum.HumanoidRigType.R15)
	end)
	if not ok or not rig then return nil, tostring(rig) end

	local parent = resolveOrSearchPath(act.parent) or workspace
	local name = act.name or "NPC"
	if act.replace ~= false then
		for _, ch in ipairs(parent:GetChildren()) do
			if ch.Name == name and ch:IsA("Model") then ch:Destroy() end
		end
	end
	rig.Name = name
	rig.Parent = parent
	if type(act.scale) == "number" and act.scale > 0 and act.scale ~= 1 then pcall(function() rig:ScaleTo(act.scale) end) end
	local pos = act.position or {0, 5, 0}
	local rotY = tonumber(act.rotation_y) or (type(act.rotation) == "table" and tonumber(act.rotation[2])) or 0
	rig:PivotTo(CFrame.new(pos[1] or 0, (pos[2] or 5), pos[3] or 0) * CFrame.Angles(0, math.rad(rotY), 0))

	local static = act.anchored == true or act.behavior == "static"
	for _, p in ipairs(rig:GetDescendants()) do
		if p:IsA("BasePart") then p.Anchored = false end
	end
	if static then rig.HumanoidRootPart.Anchored = true end

	local hum = rig:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = tonumber(act.walk_speed) or 12
		if act.display_name then hum.DisplayName = tostring(act.display_name) end
		if act.hide_name == true then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
		if not hum:FindFirstChildOfClass("Animator") then Instance.new("Animator", hum) end
	end

	rig:SetAttribute("AI_IdleAnim", act.idle_anim or ensureLocomotionAnim(isR6, "idle"))
	rig:SetAttribute("AI_WalkAnim", act.walk_anim or ensureLocomotionAnim(isR6, "walk"))
	rig:SetAttribute("AI_RunAnim", act.run_anim or ensureLocomotionAnim(isR6, "run"))
	CollectionService:AddTag(rig, "AI_Locomotion")

	local behavior = act.behavior or "idle"
	if behavior ~= "static" then
		rig:SetAttribute("AI_Behavior", behavior)
		if act.wander_radius then rig:SetAttribute("AI_WanderRadius", tonumber(act.wander_radius)) end
		if type(act.patrol_points) == "table" then rig:SetAttribute("AI_Patrol", HttpService:JSONEncode(act.patrol_points)) end
		if act.target_path then rig:SetAttribute("AI_TargetPath", tostring(act.target_path)) end
		if act.follow_distance then rig:SetAttribute("AI_FollowDistance", tonumber(act.follow_distance)) end
		if act.sight_range then rig:SetAttribute("AI_SightRange", tonumber(act.sight_range)) end
		CollectionService:AddTag(rig, "AI_NPC")
		ensureNpcBrain()
	end
	local function setAttrSmart(key, v)
		if type(v) == "table" then
			if #v == 2 and type(v[1]) == "number" and type(v[2]) == "number" then
				rig:SetAttribute(key, NumberRange.new(math.min(v[1], v[2]), math.max(v[1], v[2])))
			else
				rig:SetAttribute(key, HttpService:JSONEncode(v))
			end
		else
			rig:SetAttribute(key, v)
		end
	end
	if act.restrict_x ~= nil then pcall(setAttrSmart, "RestrictX", act.restrict_x) end
	if act.restrict_z ~= nil then pcall(setAttrSmart, "RestrictZ", act.restrict_z) end
	if type(act.attributes) == "table" then
		for k, v in pairs(act.attributes) do pcall(setAttrSmart, tostring(k), v) end
	end
	return rig
end

